# Copy this file to .env and fill in real values. Never commit .env.

# MongoDB connection string (required - the app exits on startup without it)
MONGO_URI=mongodb://localhost:27017/user-management

# Secret used to sign the session cookie (required - the app throws on startup without it).
# Note the lowercase leading 's': this is the exact name app.ts reads.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
secretSession=

# Port the HTTP server listens on (optional, defaults to 3000)
PORT=3000
