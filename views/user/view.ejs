<!doctype html>
<html lang="en">
  <head>
    <title>Auth V1 | User Details</title>
    <%- include('../partials/head') %>
    <style>
      .main {
        position: relative;
        z-index: 1;
        max-width: 680px;
        margin: 0 auto;
        padding: 100px 24px 80px;
      }
      .page-header {
        margin-bottom: 32px;
      }
      .back-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: var(--ac);
        text-decoration: none;
        font-size: 14px;
        font-weight: 500;
        margin-bottom: 24px;
        transition: var(--tr);
      }
      .back-link:hover {
        gap: 10px;
      }
      .page-header h1 {
        font-size: 28px;
        font-weight: 800;
        letter-spacing: -0.5px;
        margin-bottom: 8px;
      }
      .page-header p {
        font-size: 14px;
        color: var(--t3);
        line-height: 1.6;
      }
      .card {
        background: var(--card);
        border: 1px solid var(--brd);
        border-radius: var(--r);
        overflow: hidden;
      }
      .card-header {
        padding: 28px;
        border-bottom: 1px solid var(--brd);
        display: flex;
        align-items: center;
        gap: 18px;
      }
      .avatar {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--ac), #8b7340);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
        font-weight: 700;
        color: #0a0a0a;
        flex-shrink: 0;
      }
      .header-info h2 {
        font-size: 20px;
        font-weight: 700;
        letter-spacing: -0.3px;
        margin-bottom: 4px;
      }
      .badge {
        display: inline-block;
        font-size: 11px;
        font-weight: 600;
        color: var(--ok);
        background: rgba(74, 222, 128, 0.1);
        border: 1px solid rgba(74, 222, 128, 0.2);
        padding: 3px 10px;
        border-radius: 100px;
      }
      .card-body {
        padding: 8px 28px;
      }
      .row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 18px 0;
        border-bottom: 1px solid var(--brd);
      }
      .row:last-child {
        border-bottom: none;
      }
      .row-label {
        font-size: 12px;
        font-weight: 600;
        color: var(--t3);
        text-transform: uppercase;
        letter-spacing: 0.5px;
      }
      .row-value {
        font-size: 14px;
        color: var(--t1);
        word-break: break-all;
        text-align: right;
        max-width: 60%;
      }
      .card-actions {
        padding: 20px 28px;
        border-top: 1px solid var(--brd);
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
      }
      .btn-action {
        padding: 10px 18px;
        font-size: 13px;
        font-weight: 500;
        border-radius: 8px;
        border: 1px solid var(--brd);
        background: transparent;
        color: var(--t1);
        font-family: inherit;
        cursor: pointer;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: var(--tr);
      }
      .btn-action:hover {
        border-color: var(--ac);
        color: var(--ac);
        background: rgba(192, 163, 110, 0.05);
      }
      .btn-action.danger {
        color: var(--err);
        border-color: rgba(224, 82, 82, 0.2);
      }
      .btn-action.danger:hover {
        border-color: var(--err);
        background: rgba(224, 82, 82, 0.08);
      }
      .delete-form {
        margin: 0;
      }
      @media (max-width: 768px) {
        .main {
          padding: 80px 16px 60px;
        }
        .card-header {
          flex-direction: column;
          text-align: center;
        }
        .row {
          flex-direction: column;
          align-items: flex-start;
          gap: 6px;
        }
        .row-value {
          max-width: 100%;
          text-align: left;
        }
      }
    </style>
  </head>
  <body>
    <%- include('../partials/navbar') %>
    <main class="main">
      <div class="page-header">
        <a href="/" class="back-link">← Back to Dashboard</a>
        <h1>User Details</h1>
        <p>Full information for this user.</p>
      </div>

      <%- include('../partials/flash', { messages: messages }) %>

      <div class="card">
        <div class="card-header">
          <div class="avatar"><%= user.firstName.charAt(0).toUpperCase() %></div>
          <div class="header-info">
            <h2><%= user.firstName %> <%= user.secondName %></h2>
            <span class="badge">Active</span>
          </div>
        </div>

        <div class="card-body">
          <div class="row">
            <span class="row-label">User ID</span>
            <span class="row-value"><%= user._id %></span>
          </div>
          <div class="row">
            <span class="row-label">First Name</span>
            <span class="row-value"><%= user.firstName %></span>
          </div>
          <div class="row">
            <span class="row-label">Last Name</span>
            <span class="row-value"><%= user.secondName %></span>
          </div>
          <div class="row">
            <span class="row-label">Email</span>
            <span class="row-value"><%= user.email %></span>
          </div>
          <div class="row">
            <span class="row-label">Phone</span>
            <span class="row-value"><%= user.phoneNumber %></span>
          </div>
          <div class="row">
            <span class="row-label">Member Since</span>
            <span class="row-value"><%= user.createdAt.toLocaleString() %></span>
          </div>
        </div>

        <div class="card-actions">
          <a href="/user/edit/<%= user._id %>" class="btn-action">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
              <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
            </svg>
            Edit
          </a>
          <form
            class="delete-form"
            action="/users/<%= user._id %>?_method=DELETE"
            method="POST"
            onsubmit="return confirm('Are you sure you want to delete this user?');"
          >
            <button type="submit" class="btn-action danger">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="3 6 5 6 21 6"></polyline>
                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
              </svg>
              Delete
            </button>
          </form>
        </div>
      </div>
    </main>
  </body>
</html>
