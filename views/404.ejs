<!doctype html>
<html lang="en">
<head>
  <title>Auth V1 | 404</title>
  <%- include('partials/head') %>
  <style>
    .page{position:relative;z-index:1;display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:100vh;text-align:center;padding:24px}
    .code{font-size:120px;font-weight:800;letter-spacing:-4px;background:linear-gradient(135deg,var(--ac),#8b7340);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;line-height:1}
    .msg{font-size:18px;color:var(--t2);margin:16px 0 32px;max-width:400px}
    .home-btn{display:inline-flex;align-items:center;gap:8px;padding:12px 28px;border-radius:8px;background:var(--card);border:1px solid var(--brd);color:var(--t1);text-decoration:none;font-family:inherit;font-size:14px;font-weight:600;transition:var(--tr)}
    .home-btn:hover{border-color:var(--brd-h);background:var(--card-h)}
  </style>
</head>
<body>
  <%- include('partials/navbar') %>
  <div class="page">
    <div class="code">404</div>
    <p class="msg">The page you are looking for does not exist or has been moved.</p>
    <a href="/" class="home-btn">&larr; Back to Dashboard</a>
  </div>
</body>
</html>
