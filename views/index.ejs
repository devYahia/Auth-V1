<!doctype html>
<html lang="en">
  <head>
    <meta name="description" content="Auth V1 - User Management System" />
    <title>Auth V1 | Dashboard</title>
    <%- include('partials/head') %>
    <style>
      .main {
        position: relative;
        z-index: 1;
        max-width: 1200px;
        margin: 0 auto;
        padding: 100px 24px 80px;
      }
      .main-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 32px;
        flex-wrap: wrap;
        gap: 16px;
      }
      .main-header h1 {
        font-size: 28px;
        font-weight: 800;
        letter-spacing: -0.5px;
      }
      .main-header p {
        color: var(--t3);
        font-size: 14px;
        margin-top: 4px;
      }
      .btn-add {
        padding: 10px 20px;
        background: var(--ac);
        color: #0a0a0a;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: var(--tr);
      }
      .btn-add:hover {
        opacity: 0.9;
        transform: translateY(-2px);
      }
      .section-title {
        font-size: 16px;
        font-weight: 600;
        color: var(--t2);
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 8px;
      }
      .section-title::before {
        content: "";
        display: block;
        width: 4px;
        height: 4px;
        background: var(--ac);
        border-radius: 50%;
      }
      .search-form {
        display: flex;
        gap: 12px;
        margin-bottom: 24px;
      }
      .search-input {
        flex: 1;
        padding: 12px 14px;
        background: var(--inp);
        border: 1px solid var(--brd);
        border-radius: 8px;
        font-family: inherit;
        font-size: 14px;
        color: var(--t1);
        transition: var(--tr);
      }
      .search-input:focus {
        outline: none;
        border-color: var(--brd-f);
        box-shadow: 0 0 0 3px var(--ac-g);
      }
      .search-input::placeholder {
        color: var(--t3);
      }
      .btn-search {
        padding: 12px 20px;
        background: var(--card);
        border: 1px solid var(--brd);
        border-radius: 8px;
        color: var(--t1);
        font-family: inherit;
        font-weight: 500;
        font-size: 14px;
        cursor: pointer;
        transition: var(--tr);
      }
      .btn-search:hover {
        border-color: var(--brd-h);
        background: var(--card-h);
      }
      .btn-clear {
        padding: 12px 16px;
        background: transparent;
        border: 1px solid var(--brd);
        border-radius: 8px;
        color: var(--t3);
        text-decoration: none;
        font-size: 13px;
        font-weight: 500;
        display: inline-flex;
        align-items: center;
        transition: var(--tr);
      }
      .btn-clear:hover {
        color: var(--err);
        border-color: rgba(224, 82, 82, 0.3);
      }
      .table-container {
        background: var(--card);
        border: 1px solid var(--brd);
        border-radius: var(--r);
        overflow: hidden;
      }
      .table-header,
      .table-row {
        display: grid;
        grid-template-columns: 1.5fr 1.5fr 2fr 1.5fr 1.4fr;
        padding: 16px 24px;
        align-items: center;
      }
      .table-header {
        border-bottom: 1px solid var(--brd);
        font-size: 11px;
        font-weight: 700;
        color: var(--t3);
        text-transform: uppercase;
        letter-spacing: 0.5px;
      }
      .table-row {
        border-bottom: 1px solid var(--brd);
        transition: var(--tr);
      }
      .table-row:last-child {
        border-bottom: none;
      }
      .table-row:hover {
        background: rgba(255, 255, 255, 0.02);
      }
      .cell-strong {
        font-weight: 600;
        color: var(--t1);
        font-size: 14px;
      }
      .cell {
        font-size: 13px;
        color: var(--t2);
        word-break: break-all;
      }
      .actions {
        display: flex;
        gap: 8px;
        align-items: center;
        justify-content: flex-end;
      }
      .action-btn {
        width: 36px;
        height: 36px;
        border: 1px solid var(--brd);
        background: transparent;
        border-radius: 6px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        color: var(--t2);
        transition: var(--tr);
        text-decoration: none;
      }
      .action-btn:hover {
        border-color: var(--ac);
        color: var(--ac);
        background: rgba(192, 163, 110, 0.05);
      }
      .action-btn.delete {
        color: var(--err);
      }
      .action-btn.delete:hover {
        border-color: var(--err);
        background: rgba(224, 82, 82, 0.08);
      }
      .delete-form {
        display: inline;
        margin: 0;
      }
      .empty-state {
        text-align: center;
        padding: 60px 24px;
        color: var(--t3);
      }
      .empty-state svg {
        opacity: 0.3;
        margin-bottom: 16px;
      }
      .empty-state h3 {
        font-size: 16px;
        font-weight: 600;
        color: var(--t2);
        margin-bottom: 8px;
      }
      @media (max-width: 768px) {
        .main {
          padding: 80px 16px 60px;
        }
        .main-header {
          flex-direction: column;
          align-items: flex-start;
        }
        .table-header {
          display: none;
        }
        .table-row {
          grid-template-columns: 1fr;
          gap: 8px;
        }
        .actions {
          justify-content: flex-start;
        }
      }
    </style>
  </head>
  <body>
    <%- include('partials/navbar') %>

    <main class="main">
      <div class="main-header">
        <div>
          <h1>Dashboard</h1>
          <p>Manage all your users in one place</p>
        </div>
        <a href="/user/add" class="btn-add">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
          </svg>
          Add User
        </a>
      </div>

      <%- include('partials/flash', { messages: messages }) %>

      <h2 class="section-title">All Users</h2>

      <form class="search-form" method="GET" action="/">
        <input
          type="text"
          name="search"
          class="search-input"
          placeholder="Search by first name, last name or email..."
          value="<%= typeof search !== 'undefined' ? search : '' %>"
        />
        <button type="submit" class="btn-search">Search</button>
        <% if (typeof search !== 'undefined' && search) { %>
          <a href="/" class="btn-clear">Clear</a>
        <% } %>
      </form>

      <% if (users && users.length > 0) { %>
        <div class="table-container">
          <div class="table-header">
            <div>First Name</div>
            <div>Last Name</div>
            <div>Email</div>
            <div>Phone</div>
            <div style="text-align: right">Actions</div>
          </div>
          <% users.forEach(function(user) { %>
            <div class="table-row">
              <div class="cell-strong"><%= user.firstName %></div>
              <div class="cell-strong"><%= user.secondName %></div>
              <div class="cell"><%= user.email %></div>
              <div class="cell"><%= user.phoneNumber %></div>
              <div class="actions">
                <a href="/user/view/<%= user._id %>" class="action-btn" title="View user">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                    <circle cx="12" cy="12" r="3"></circle>
                  </svg>
                </a>
                <a href="/user/edit/<%= user._id %>" class="action-btn" title="Edit user">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                  </svg>
                </a>
                <form
                  class="delete-form"
                  action="/users/<%= user._id %>?_method=DELETE"
                  method="POST"
                  onsubmit="return confirm('Are you sure you want to delete this user?');"
                >
                  <button type="submit" class="action-btn delete" title="Delete user">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="3 6 5 6 21 6"></polyline>
                      <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                    </svg>
                  </button>
                </form>
              </div>
            </div>
          <% }); %>
        </div>
      <% } else { %>
        <div class="empty-state">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
            <circle cx="9" cy="7" r="4"></circle>
            <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
          </svg>
          <h3>
            <% if (typeof search !== 'undefined' && search) { %>
              No users match your search
            <% } else { %>
              No users found
            <% } %>
          </h3>
          <p>
            <% if (typeof search !== 'undefined' && search) { %>
              Try a different keyword or clear the search.
            <% } else { %>
              Start by adding your first user to get started.
            <% } %>
          </p>
        </div>
      <% } %>
    </main>
  </body>
</html>
